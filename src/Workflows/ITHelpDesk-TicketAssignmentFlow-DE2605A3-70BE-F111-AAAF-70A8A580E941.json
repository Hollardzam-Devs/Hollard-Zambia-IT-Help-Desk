          "connectionReferenceLogicalName": "new_sharedoffice365_a1f95"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "dg_tickets",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "dg_supportstaff"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "connectionName": "shared_commondataserviceforapps"
            }
          },
          "metadata": {
            "operationMetadataId": "5f421b8f-3f06-4c0b-a5b6-69adb54aad9a"
          }
        }
      },
      "actions": {
        "Condition": {
          "type": "If",
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@triggerOutputs()?['body/_dg_supportstaff_value']",
                    null
                  ]
                }
              }
            ]
          },
          "actions": {
            "Get_a_row_by_ID": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "dg_supportstaffs",
                  "recordId": "@triggerOutputs()?['body/_dg_supportstaff_value']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            },
            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@outputs('Get_a_row_by_ID')?['body/dg_staffemail']",
                  "emailMessage/Subject": "New Ticket Assigned - @{triggerOutputs()?['body/dg_ticketnumber']}",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Hello<br><br>A new IT Help Desk ticket has been assigned to you.<br><br>Ticket Number : @{triggerOutputs()?['body/dg_jobnumber']}</p><br><p class=\"editor-paragraph\">Ticket Type : @{triggerOutputs()?['body/dg_jobtype']}<br><br>Description: @{triggerOutputs()?['body/dg_description']}<br><br>Priority: @{triggerOutputs()?['_dg_priority_label']}<br><br>Please review and take the necessary action.<br><br>IT Help Desk System</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              },
              "runAfter": {
                "Get_a_row_by_ID": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "b449f94c-e423-47b3-a5a7-01ee87f4823c"
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}